        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "gnqqqhinuorp3q6mo72d1lhpu0@group.calendar.google.com"
        },
        "options": {
          "timeMin": "={{ (() => { const d = new Date($json.date + 'T00:00:00Z'); d.setDate(d.getDate() - 1); return d.toISOString(); })() }}",
          "timeMax": "={{ (() => { const d = new Date($json.date + 'T00:00:00Z'); d.setDate(d.getDate() + 3); return d.toISOString(); })() }}"
        }
