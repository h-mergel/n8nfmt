        "jsCode": "const items = $input.all();\nconst currentEvent = $('Code: Set Current Event').first().json;\nconst parsed = items[0].json;\nconst isDuplicate = parsed.isDuplicate === true;\nconst reason = parsed.reason || (isDuplicate ? 'Duplikat erkannt' : 'Kein Duplikat');\nreturn [{ json: { ...currentEvent, isDuplicate, reason } }];"
