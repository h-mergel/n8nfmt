    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst parsed = items[0].json;\nconst events = (parsed.events || []).filter(e => e.date && e.title);\n\nconst subject = $('Code: Init Email').first().json.subject;\nconst mailDate = $('Code: Init Email').first().json.mailDate;\n\nif (events.length === 0) {\n  return [{ json: { type: 'no_events', status: '', title: '', date: '', startTime: '', endTime: '', allDay: false, location: '', description: '', detail: subject, link: '', mailSubject: subject, mailDate } }];\n}\n\nreturn events.map(e => ({\n  json: {\n    type: 'event',\n    status: 'pending',\n    title: e.title,\n    date: e.date,\n    startTime: e.startTime || '',\n    endTime: e.endTime || '',\n    allDay: e.allDay === true,\n    location: e.location || '',\n    description: e.description || '',\n    detail: '',\n    link: '',\n    mailSubject: subject,\n    mailDate\n  }\n}));"
      },
