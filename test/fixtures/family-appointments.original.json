      "parameters": {
        "promptType": "define",
        "text": "={{ $json.dupCheckUserContent }}",
        "messages": {
          "messageValues": [
            {
              "message": "Vergleiche das NEUE Event mit den EXISTIERENDEN Kalendereinträgen.\nEin Duplikat liegt vor wenn:\n- Es sich um dasselbe reale Ereignis handelt (gleiche Aktivität, gleicher Tag)\n- Auch wenn Formulierung/Titel leicht abweicht\n- Eine Erinnerung an ein bestehendes Event ist ein Duplikat\n\nAntworte NUR mit JSON:\n{\"isDuplicate\": true, \"reason\": \"Kurze Begründung\"}\noder\n{\"isDuplicate\": false, \"reason\": \"Kurze Begründung\"}"
            }
          ]
        },
        "batching": {}
      },
