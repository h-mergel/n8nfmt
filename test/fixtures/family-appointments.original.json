      "id": "00000007-0000-4000-a000-000000000007",
      "name": "Extract from File",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        784,
        648
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst item = items[0];\nconst json = item.json;\n\nlet binaryData = {};\ntry { binaryData = $('Code: Init Email').first().binary || {}; } catch(e) { binaryData = item.binary || {}; }\n\nlet mergedText = json.mergedText || ('Betreff: ' + (json.subject || '') + '\\n\\n' + (json.bodyText || ''));\n\nif (json.pdfText) {\n  mergedText += '\\n\\n--- PDF-Anhang ---\\n' + json.pdfText;\n}\n\nconst binaryKeys = Object.keys(binaryData);\nfor (const key of binaryKeys) {\n  const b = binaryData[key];\n  if (b && (b.mimeType === 'text/calendar' || (b.fileName && b.fileName.toLowerCase().endsWith('.ics')))) {\n    try { mergedText += '\\n\\n--- Kalender-Datei (.ics) ---\\n' + Buffer.from(b.data, 'base64').toString('utf-8'); } catch(e) {}\n  }\n}\n\nreturn [{ json: { ...json, mergedText }, binary: binaryData }];"
      },
