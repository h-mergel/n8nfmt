        "jsCode": "let binaryData = {};\ntry { binaryData = $('Code: Collect Texts').first().binary || {}; } catch(e) {\n  try { binaryData = $('Code: Init Email').first().binary || {}; } catch(e2) { binaryData = {}; }\n}\n\nconst binaryKeys = Object.keys(binaryData);\nif (binaryKeys.length === 0) return [{ json: { hasAttachments: false } }];\n\nreturn binaryKeys.map(key => {\n  const b = binaryData[key];\n  return { json: { hasAttachments: true, fileName: b.fileName || key, mimeType: b.mimeType || 'application/octet-stream' }, binary: { upload: b } };\n});"
