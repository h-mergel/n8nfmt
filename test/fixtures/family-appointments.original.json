    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst currentEvent = $('Code: Set Current Event').first().json;\n\nconst calendarEvents = items\n  .filter(i => i.json && i.json.summary)\n  .map(i => ({ summary: i.json.summary, start: i.json.start, end: i.json.end, description: i.json.description, location: i.json.location }));\n\nconst dupCheckUserContent = 'NEUES EVENT:\\n' + JSON.stringify(currentEvent, null, 2) +\n  '\\n\\nEXISTIERENDE EVENTS IM KALENDER (' + calendarEvents.length + ' gefunden):\\n' +\n  JSON.stringify(calendarEvents, null, 2);\n\nreturn [{ json: { ...currentEvent, dupCheckUserContent, calendarEventsCount: calendarEvents.length } }];"
      },
