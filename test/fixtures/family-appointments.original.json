        304,
        2184
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst rows = items.map(i => i.json);\n\nconst created = rows.filter(r => r.type === 'event' && r.status === 'created');\nconst skipped = rows.filter(r => r.type === 'event' && r.status === 'skipped');\nconst noEvents = rows.filter(r => r.type === 'no_events');\nconst attachments = rows.filter(r => r.type === 'attachment');\nconst pdfErrors = rows.filter(r => r.type === 'pdf_error');\n\nconst hasActions = created.length > 0 || skipped.length > 0 || noEvents.length > 0;\nif (!hasActions) return [{ json: { hasActions: false } }];\n\nlet html = '<h2>\\ud83d\\udccb Family Appointments \\u2014 Zusammenfassung</h2>';\n\nif (created.length > 0) {\n  html += '<h3>\\ud83d\\udcc5 Neue Termine (' + created.length + ')</h3><ul>';\n  for (const e of created) {\n    html += '<li><strong>' + e.title + '</strong> \\u2014 ' + e.date;\n    if (e.startTime) html += ', ' + e.startTime + ' Uhr';\n    else if (e.allDay) html += ' (ganzt\\u00e4gig)';\n    if (e.link) html += ' <a href=\"' + e.link + '\">\\ud83d\\udcc5 Im Kalender</a>';\n    html += '</li>';\n  }\n  html += '</ul>';\n}\n\nif (skipped.length > 0) {\n  html += '<h3>\\u23ed\\ufe0f Duplikate \\u00fcbersprungen (' + skipped.length + ')</h3><ul>';\n  for (const e of skipped) html += '<li>' + e.title + ' \\u2014 ' + e.date + ' (' + (e.detail || 'Duplikat') + ')</li>';\n  html += '</ul>';\n}\n\nif (noEvents.length > 0) {\n  html += '<h3>\\ud83d\\udced Emails ohne Termin (' + noEvents.length + ')</h3><ul>';\n  for (const m of noEvents) html += '<li>\\u201c' + (m.detail || m.mailSubject) + '\\u201d \\u2014 ' + (m.mailDate ? m.mailDate.split('T')[0] : '') + '</li>';\n  html += '</ul>';\n}\n\nif (attachments.length > 0) {\n  html += '<h3>\\ud83d\\udcce Anh\\u00e4nge in Google Drive (' + attachments.length + ')</h3><ul>';\n  for (const a of attachments) {\n    if (a.link) html += '<li><a href=\"' + a.link + '\">' + a.title + '</a></li>';\n    else html += '<li>' + a.title + '</li>';\n  }\n  html += '</ul>';\n}\n\nif (pdfErrors.length > 0) {\n  html += '<h3>\\u26a0\\ufe0f PDF-Extraktion fehlgeschlagen</h3><ul>';\n  for (const p of pdfErrors) html += '<li>' + p.title + ' (aus: \\u201c' + p.mailSubject + '\\u201d)</li>';\n  html += '</ul>';\n}\n\nconst parts = [];\nif (created.length > 0) parts.push(created.length + ' neue Termine');\nif (skipped.length > 0) parts.push(skipped.length + ' Duplikate');\nif (noEvents.length > 0) parts.push(noEvents.length + ' ohne Termin');\n\nreturn [{ json: { hasActions: true, to: 'h.mergel@gmail.com', subject: '\\ud83d\\udccb Family Appointments: ' + parts.join(', '), htmlBody: html } }];"
      },
