    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst emailItem = items[0];\nconst emailJson = emailItem.json;\nconst binaryData = emailItem.binary || {};\n\nconst subject = emailJson.subject || (emailJson.snippet ? emailJson.snippet.substring(0, 100) : 'Kein Betreff');\nconst mailDate = emailJson.date || new Date().toISOString();\n\nlet bodyText = '';\nif (emailJson.text) bodyText = emailJson.text;\nelse if (emailJson.textPlain) bodyText = emailJson.textPlain;\nelse if (emailJson.html) bodyText = emailJson.html.replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ').trim();\nelse if (emailJson.snippet) bodyText = emailJson.snippet;\n\nconst binaryKeys = Object.keys(binaryData);\nconst firstPdfKey = binaryKeys.find(key => {\n  const b = binaryData[key];\n  return b.mimeType === 'application/pdf' || (b.fileName && b.fileName.toLowerCase().endsWith('.pdf'));\n}) || null;\n\nreturn [{\n  json: { subject, mailDate, bodyText, mergedText: 'Betreff: ' + subject + '\\n\\n' + bodyText, hasAttachments: binaryKeys.length > 0, hasPdfs: firstPdfKey !== null, firstPdfKey, binaryKeys },\n  binary: binaryData\n}];"
      },
      "id": "00000005-0000-4000-a000-000000000005",
