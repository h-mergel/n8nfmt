    {
      "parameters": {
        "jsCode": "const markdowns = $json.markdowns ?? [];\nconst imageSection = markdowns.length > 0\n  ? `\\n\\n## Screenshots\\n${markdowns.join('\\n')}`\n  : '';\nconst snapshot = $('Set: Snapshot context').item.json;\nconst content = snapshot._content ?? '';\nconst type = snapshot._type ?? '';\nlet msgId = '';\ntry { msgId = $('Discord Trigger').item.json.id ?? ''; } catch(e) {}\nreturn {\n  json: {\n    _enrichedContent: content + imageSection,\n    _imageSection: imageSection,\n    _type: type,\n    _originalContent: content,\n    _messageId: msgId,\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
