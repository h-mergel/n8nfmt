        "method": "GET",
        "url": "=https://gitlab.com/api/v4/projects/{{ $('Webhook: GitLab Implementation').item.json.body.project.id }}/issues/{{ $('Webhook: GitLab Implementation').item.json.body.object_attributes.iid }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gitlabApi",
        "options": {},
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 1000
