    {
      "parameters": {
        "httpMethod": "DELETE",
        "path": "ai-implementer-remove-job",
        "responseMode": "responseNode"
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        320,
        480
      ],
      "id": "webhook-remove-job-impl",
      "name": "Webhook: Remove Job",
      "webhookId": "ai-implementer-remove-job"
    },
    {
      "parameters": {
        "jsCode": "\nconst body = $input.first().json.body ?? {};\nconst jobId = String(body.jobId ?? '');\n\nif (!jobId) {\n  return [{ json: { ok: false, error: 'jobId required in request body' } }];\n}\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.pendingJobs) staticData.pendingJobs = {};\n\nif (staticData.pendingJobs[jobId] !== undefined) {\n  delete staticData.pendingJobs[jobId];\n  const remaining = Object.keys(staticData.pendingJobs).length;\n  return [{ json: { ok: true, removed: jobId, remaining } }];\n} else {\n  return [{ json: { ok: false, error: `jobId ${jobId} not found in pendingJobs` } }];\n}\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        480
      ],
      "id": "code-remove-job-impl",
      "name": "Code: Remove Job"
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        720,
        480
      ],
      "id": "respond-job-removed-impl",
