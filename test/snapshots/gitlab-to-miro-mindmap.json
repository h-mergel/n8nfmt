    {
      "id": "code-prep-mistral-01",
      "name": "Code: Prep Titles for Mistral",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        280
      ],
      "parameters": {
        "jsCode": "const allItems = $input.all();\nlet issues = [];\nif (allItems.length === 1 && Array.isArray(allItems[0].json)) {\n  issues = allItems[0].json;\n} else {\n  issues = allItems.map(i => i.json);\n}\n\nconst lines = issues.map(i => `${i.iid}: ${i.title}`).join('\\n');\n\nconst prompt = `Formuliere jeden der folgenden GitLab-Issue-Titel fuer eine Mindmap um.\\nJeder Titel soll max. 5 Woerter haben, praegnant auf Deutsch.\\nAntworte NUR mit einem JSON-Objekt: { \"<iid>\": \"<kurztitel>\", ... }\\n\\nIssues:\\n${lines}`;\n\nreturn [{ json: { prompt, _rawIssues: issues } }];"
      }
    },
    {
      "id": "chain-llm-01",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        920,
        280
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}",
        "options": {}
      }
    },
    {
      "id": "code-parse-mistral-01",
      "name": "Code: Parse Mistral Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1260,
        280
      ],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\n// chainLlm outputs { response: \"...\" } or { text: \"...\" } or directly the string\nlet content = resp.response || resp.text || '{}';\n// Try parsing as JSON (Mistral json_object format)\ntry {\n  const parsed = JSON.parse(content);\n  content = JSON.stringify(parsed);\n} catch(e) {}\n// Parse short titles\nlet shortTitles = {};\ntry { shortTitles = JSON.parse(content); } catch(e) {}\n\nconst rawIssues = $('Code: Prep Titles for Mistral').first().json._rawIssues;\nreturn [{ json: { shortTitles, _rawIssues: rawIssues } }];"
      }
    },
    {
      "id": "code-group-01",
      "name": "Code: Group Issues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        280
      ],
      "parameters": {
        "jsCode": "const { shortTitles, _rawIssues: issues } = $input.first().json;\n\nconst shorten = (title, iid) => {\n  const s = shortTitles[String(iid)];\n  if (s) return s;\n  return title.length > 40 ? title.slice(0, 39) + '\\u2026' : title;\n};\n\nconst msMap = {};\nfor (const issue of issues) {\n  const ms = issue.milestone?.title ?? 'Kein Milestone';\n  const sortedLabels = (issue.labels ?? []).sort();\n  const primaryLabel = sortedLabels[0] ?? 'Kein Label';\n  if (!msMap[ms]) msMap[ms] = {};\n  if (!msMap[ms][primaryLabel]) msMap[ms][primaryLabel] = [];\n  msMap[ms][primaryLabel].push({ short: shorten(issue.title, issue.iid), iid: issue.iid, url: issue.web_url, labels: sortedLabels });\n}\n\nconst groups = Object.entries(msMap).map(([ms, labels]) => ({\n  milestoneTitle: ms,\n  _tempId: `m_${ms}`,\n  labels: Object.entries(labels).map(([lb, iss]) => ({\n    labelName: lb,\n    _tempId: `l_${ms}_${lb}`,\n    issues: iss\n  }))\n}));\n\nreturn [{ json: { groups } }];"
      }
    },
