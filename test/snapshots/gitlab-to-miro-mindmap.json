    {
      "id": "code-prep-milestones-01",
      "name": "Code: Prep Milestones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4460,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const groups = $('Code: Group Issues').first().json.groups;\nconst rootId = String($('HTTP: POST Root').first().json.id);\nconst sd = $getWorkflowStaticData('global');\nsd.posMap = {};\n\nconst ISSUE_H = 70;\nconst LABEL_PAD = 40;\nconst MS_PAD = 60;\nconst MS_X = 300;\n\nfunction msHeight(g) {\n  return g.labels.reduce((s, l) => s + l.issues.length * ISSUE_H, 0) + Math.max(0, g.labels.length - 1) * LABEL_PAD;\n}\n\nconst totalH = groups.reduce((s, g) => s + msHeight(g), 0) + Math.max(0, groups.length - 1) * MS_PAD;\nlet y = -totalH / 2;\nconst items = [];\nfor (const g of groups) {\n  const h = msHeight(g);\n  const msY = Math.round(y + h / 2);\n  sd.posMap[g._tempId] = msY;\n  items.push({ json: { content: g.milestoneTitle, _tempId: g._tempId, _parentId: rootId, _posX: MS_X, _posY: msY, _nodeColor: '#4fc3f7', _fillOpacity: '0.2' } });\n  y += h + MS_PAD;\n}\nreturn items;"
      }
    },
    {
      "id": "miro-post-milestone-01",
      "name": "HTTP: POST Milestone",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        4660,
        280
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.miro.com/v2-experimental/boards/uXjVHPe8zqc=/mindmap_nodes",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "miroOAuth2Api",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ data: { nodeView: { data: { type: 'text', content: $json.content } } }, parent: { id: $json._parentId }, position: { x: $json._posX, y: $json._posY }, geometry: { width: 280 } }) }}",
        "options": {
