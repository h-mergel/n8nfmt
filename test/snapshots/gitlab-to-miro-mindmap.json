    {
      "id": "code-collect-milestone-ids-01",
      "name": "Code: Collect Milestone IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4860,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sd = $getWorkflowStaticData('global');\nif (!sd.miroMap) sd.miroMap = {};\nconst httpResponses = $input.all();\nconst prepItems = $('Code: Prep Milestones').all();\nfor (let i = 0; i < Math.min(httpResponses.length, prepItems.length); i++) {\n  sd.miroMap[prepItems[i].json._tempId] = String(httpResponses[i].json.id);\n}\nreturn [{ json: { collected: httpResponses.length } }];"
      }
    },
    {
      "id": "code-prep-labels-01",
      "name": "Code: Prep Labels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5060,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const groups = $('Code: Group Issues').first().json.groups;\nconst sd = $getWorkflowStaticData('global');\n\nconst ISSUE_H = 70;\nconst LABEL_PAD = 40;\nconst LABEL_X = 600;\n\nconst items = [];\nfor (const g of groups) {\n  const milestoneId = sd.miroMap[g._tempId];\n  const msY = sd.posMap[g._tempId] || 0;\n  const totalH = g.labels.reduce((s, l) => s + l.issues.length * ISSUE_H, 0) + Math.max(0, g.labels.length - 1) * LABEL_PAD;\n  let y = msY - totalH / 2;\n  for (const l of g.labels) {\n    const h = l.issues.length * ISSUE_H;\n    const labelY = Math.round(y + h / 2);\n    sd.posMap[l._tempId] = labelY;\n    items.push({ json: { content: l.labelName, _tempId: l._tempId, _parentId: milestoneId, _posX: LABEL_X, _posY: labelY, _nodeColor: '#81c784', _fillOpacity: '0.15' } });\n    y += h + LABEL_PAD;\n  }\n}\nreturn items;"
      }
    },
    {
      "id": "miro-post-label-01",
      "name": "HTTP: POST Label",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        5260,
        280
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.miro.com/v2-experimental/boards/uXjVHPe8zqc=/mindmap_nodes",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "miroOAuth2Api",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ data: { nodeView: { data: { type: 'text', content: $json.content } } }, parent: { id: $json._parentId }, position: { x: $json._posX, y: $json._posY }, geometry: { width: 280 } }) }}",
