    {
      "id": "code-collect-label-ids-01",
      "name": "Code: Collect Label IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5460,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sd = $getWorkflowStaticData('global');\nif (!sd.miroMap) sd.miroMap = {};\nconst httpResponses = $input.all();\nconst prepItems = $('Code: Prep Labels').all();\nfor (let i = 0; i < Math.min(httpResponses.length, prepItems.length); i++) {\n  sd.miroMap[prepItems[i].json._tempId] = String(httpResponses[i].json.id);\n}\nreturn [{ json: { collected: httpResponses.length } }];"
      }
    },
    {
      "id": "code-prep-issues-01",
      "name": "Code: Prep Issues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5660,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const groups = $('Code: Group Issues').first().json.groups;\nconst sd = $getWorkflowStaticData('global');\n\nconst ISSUE_H = 70;\nconst ISSUE_X = 900;\n\nfunction issueColor(labels) {\n  if (!labels || !labels.length) return { nodeColor: '#ba68c8' };\n  const ls = labels.map(l => l.toLowerCase());\n  if (ls.some(l => l.includes('type: bug') || l.includes('type::bug'))) return { nodeColor: '#e57373' };\n  if (ls.some(l => l.includes('type: feature') || l.includes('type::feature'))) return { nodeColor: '#64b5f6' };\n  if (ls.some(l => l.includes('type: task') || l.includes('type::task'))) return { nodeColor: '#ffb74d' };\n  if (ls.some(l => l.includes('type: enhancement') || l.includes('type::enhancement'))) return { nodeColor: '#4dd0e1' };\n  return { nodeColor: '#ba68c8' };\n}\n\nconst items = [];\nfor (const g of groups) {\n  for (const l of g.labels) {\n    const labelId = sd.miroMap[l._tempId];\n    const labelY = sd.posMap[l._tempId] || 0;\n    const n = l.issues.length;\n    l.issues.forEach((issue, idx) => {\n      const issueY = Math.round(labelY + (idx - (n - 1) / 2) * ISSUE_H);\n      const content = `#${issue.iid} ${issue.short}`;\n      const colors = issueColor(issue.labels || []);\n      items.push({ json: { content, _parentId: labelId, iid: issue.iid, _posX: ISSUE_X, _posY: issueY, _nodeColor: colors.nodeColor, _fillOpacity: '0.15' } });\n    });\n  }\n}\nreturn items;"
      }
    },
    {
      "id": "miro-post-issue-01",
