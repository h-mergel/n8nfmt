    {
      "id": "poll-filter-03",
      "name": "Code: Filter Unqueued Issues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        280
      ],
      "parameters": {
        "jsCode": "\n// GitLab API returns issues as a JSON array — httpRequest wraps it as a single item\nconst allItems = $input.all();\nlet issues = [];\nif (allItems.length === 1 && Array.isArray(allItems[0].json)) {\n  issues = allItems[0].json;\n} else {\n  issues = allItems.map(item => item.json);\n}\n\n// Layer 2 dedup: skip any issue already registered in pendingJobs\n// (covers the case where the webhook fired and registered the job before the poller ran)\nconst staticData = $getWorkflowStaticData('global');\nconst pendingIids = new Set(\n  Object.values(staticData.pendingJobs ?? {}).map(j => Number(j.issueIid))\n);\n\nconst unqueued = issues.filter(issue => !pendingIids.has(Number(issue.iid)));\n\n// No unqueued issues — nothing to trigger\nif (unqueued.length === 0) return [];\n\nreturn unqueued.map(issue => ({\n  json: {\n    iid: issue.iid,\n    title: issue.title ?? '',\n    description: issue.description ?? '',\n    assignee: issue.assignees?.[0]?.username ?? '',\n  }\n}));\n"
      }
