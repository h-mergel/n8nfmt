    {
      "id": "n2",
      "name": "Code: Validate & Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        480
      ],
      "parameters": {
        "jsCode": "const headers = $('Webhook: GitLab Issue').item.json.headers;\nconst body    = $('Webhook: GitLab Issue').item.json.body;\n\nconst secret = headers['x-gitlab-token'] ?? '';\nif (secret !== '1aa775b82eca4db73fb36a775f652c83459dd1d1dacb317641a9b1b5f3380b34') {\n  throw new Error('Invalid webhook secret');\n}\n\nconst action         = body.object_attributes?.action ?? '';\nconst assignee       = body.assignees?.[0]?.username ?? '';\nconst issueIid       = body.object_attributes?.iid;\nconst issueProjectId = String(body.project?.id ?? '');\nconst knownDevs      = ['henry2k'];\n\nconst currentIssue  = $input.first().json;\nconst currentLabels = currentIssue.labels ?? [];\n\nconst staticData  = $getWorkflowStaticData('global');\nconst pendingJobs = staticData.pendingJobs ?? {};\n\nconst dedupeKey     = `${issueProjectId}:${issueIid}`;\nconst alreadyQueued = Object.values(pendingJobs).some(\n  j => `${j.issueProjectId}:${j.issueIid}` === dedupeKey\n);\n\nconst hasRequiredLabels = currentLabels.includes('Plan') && currentLabels.includes('Agent');\nif (!hasRequiredLabels && alreadyQueued) {\n  const keyToRemove = Object.keys(pendingJobs).find(\n    k => `${pendingJobs[k].issueProjectId}:${pendingJobs[k].issueIid}` === dedupeKey\n  );\n  if (keyToRemove) {\n    delete staticData.pendingJobs[keyToRemove];\n  }\n}\n\nconst shouldProcess =\n  !alreadyQueued &&\n  hasRequiredLabels &&\n  knownDevs.includes(assignee) &&\n  ['open', 'update', 'reopen'].includes(action);\n\nreturn [{\n  json: {\n    shouldProcess,\n    issueIid,\n    issueProjectId,\n    issueTitle: body.object_attributes?.title ?? '',\n    issueDesc:  body.object_attributes?.description ?? '',\n    assignee,\n  }\n}];"
      }
    },
    {
      "id": "n3",
      "name": "IF: Should Process?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        920,
        480
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.shouldProcess }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "n4",
