      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        480
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nreturn [{\n  json: {\n    jobId:          $execution.id,\n    issueIid:       input.issueIid,\n    issueProjectId: input.issueProjectId,\n    issueTitle:     input.issueTitle,\n    issueDesc:      input.issueDesc,\n    assignee:       input.assignee,\n    status:         'pending',\n    resumeUrl:      $execution.resumeUrl,\n    createdAt:      new Date().toISOString(),\n  }\n}];"
      }
    },
    {
      "id": "n15",
      "name": "Code: Register Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        480
      ],
      "parameters": {
        "jsCode": "\nconst job = $input.first().json;\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.pendingJobs) staticData.pendingJobs = {};\nstaticData.pendingJobs[job.jobId] = job;\nreturn $input.all();\n"
      }
    },
