        "jsCode": "\nconst body = $input.first().json.body;\nreturn [{\n  json: {\n    jobId:    body.jobId,\n    issueIid: body.issueIid,\n    planPath: body.planPath,\n    plan:     body.plan,\n  }\n}];\n"
